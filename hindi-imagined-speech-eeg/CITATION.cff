    # institutional email here is standard academic practice and the
    # address is already public via the university directory, so this
    # is not treated as participant-level PII. Even so, confirm with
    # Dr. Goyal whether she is comfortable with it appearing in a
    # public repository before this repo is made public, and remove or
    # replace with a department contact if she prefers.
repository-code: "[GitHub URL — to be added once repository is published]"
